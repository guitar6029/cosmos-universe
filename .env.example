# Sanity project configuration
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Astro Pop / Stripe
ASTROPOP_STRIPE_SECRET_KEY=
ASTROPOP_STRIPE_PUBLISHABLE_KEY=
ASTROPOP_STRIPE_WEBHOOK_SECRET=

# Neon PostgreSQL — Astro Pop
ASTROPOP_DIRECT_URL=
ASTROPOP_POOLED_URL=
COSMOPORT_APP_URL=

# Neon PostgreSQL — shared CosmoPort Core (values differ by Doppler environment)
COSMOPORT_CORE_DIRECT_URL=
COSMOPORT_CORE_POOLED_URL=

# Clerk Authentication — CosmoPort Universe
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=

# Clerk Webhooks (separate signing secrets for user/profile and email events)
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_EMAIL_WEBHOOK_SIGNING_SECRET=

# Resend transactional email delivery (server-side only)
RESEND_API_KEY=
# Set to true only after cutover; every other value disables delivery.
RESEND_EMAIL_DELIVERY_ENABLED=
