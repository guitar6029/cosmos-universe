{
  "name": "cosmos-universe",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "lint": "nuxt prepare && eslint . --max-warnings=0",
    "lint:fix": "nuxt prepare && eslint . --max-warnings=0 --fix",
    "lint:css": "stylelint \"app/**/*.{css,vue}\"",
    "lint:css:fix": "stylelint \"app/**/*.{css,vue}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "validate:pr": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run test",
    "test:e2e": "playwright test",
    "test:e2e:clerk": "doppler run -p cosmoport-universe -c dev -- node scripts/run-clerk-e2e.mjs",
    "test:e2e:clerk:cleanup": "doppler run -p cosmoport-universe -c dev -- node scripts/cleanup-clerk-test-users.mjs",
    "doppler:dev": "doppler run -p cosmoport-universe -c dev -- npm run dev",
    "stripe:webhook:dev": "stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded --forward-to http://localhost:3000/api/astro-pop/stripe-webhook",
    "ngrok:webhook:dev": "ngrok http 3000",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,html,js,json,jsx,md,mdx,mjs,ts,tsx,vue,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@clerk/nuxt": "^3.1.17",
    "@neondatabase/serverless": "^1.2.0",
    "@nuxt/fonts": "^1.0.1",
    "@nuxtjs/sanity": "^2.5.0",
    "@pinia/nuxt": "^1.0.3",
    "@vue/devtools-api": "^8.2.1",
    "nuxt": "^4.0.0",
    "openai": "^7.51.0",
    "pinia": "^4.1.0",
    "resend": "^6.37.0",
    "stripe": "^23.0.1",
    "vue": "^3.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "^3.26.4",
    "@clerk/testing": "^2.2.52",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "crossws": "^0.4.17",
    "daisyui": "^5.4.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.13"
  }
}
